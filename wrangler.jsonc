{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gauravmundra-website",
  "compatibility_date": "2026-06-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 0 * * SUN"]
  },
  "routes": [
    {
      "pattern": "gauravmundra.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "GITHUB_REPO": "gmundra/gauravmundra-website"
  }
}